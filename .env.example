# Server
PORT=8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vetcare

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional: API key the chatbot frontend must send as `x-api-key`
# Leave blank to disable API-key checks in development
API_KEY=

# Grok (xAI) — powers the chatbot's replies
# Get a key at https://console.x.ai
GROK_API_KEY=
# Optional model name (defaults to grok-4; see https://docs.x.ai for the list)
GROK_MODEL=
